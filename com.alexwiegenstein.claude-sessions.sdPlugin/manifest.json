{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.alexwiegenstein.claude-sessions",
	"Name": "Claude Sessions",
	"Version": "0.1.1.0",
	"Author": "Alex Wiegenstein",
	"URL": "https://github.com/alexwiegenstein/claude-sessions-streamdeck",
	"Description": "Shows the state of your Claude sessions (running, done, question) and opens them in the Claude desktop app at the press of a key. Unofficial; not affiliated with Anthropic.",
	"Category": "Claude Sessions",
	"CategoryIcon": "imgs/category",
	"Icon": "imgs/plugin",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"UUID": "com.alexwiegenstein.claude-sessions.session",
			"Name": "Claude Session",
			"Tooltip": "Shows one Claude session and opens it in the desktop app. Several keys fill up in order.",
			"Icon": "imgs/action",
			"PropertyInspectorPath": "ui/session.html",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/key",
					"ShowTitle": false
				}
			]
		}
	]
}